# Public site origin, used for canonical URLs, Open Graph and the sitemap.
NEXT_PUBLIC_SITE_URL=https://www.choorakkodi.com

# ---- CMS (admin at /admin) ----------------------------------------------
# Long random string that signs admin logins. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty to run the site from the built-in content with the CMS off.
PAYLOAD_SECRET=

# SQLite database file. Must be on persistent disk — back it up with /media.
DATABASE_URI=file:./data/choorakkodi.db
